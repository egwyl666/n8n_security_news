    {
      "parameters": {
        "jsCode": "let msgs = [];\ntry {\n  const t = $json.candidates[0].content.parts[0].text;\n  msgs = JSON.parse(t).messages;\n} catch (e) {}\nif (!Array.isArray(msgs) || !msgs.length) {\n  // Gemini недоступен или вернул мусор — шлём обычный формат\n  msgs = $('Сборка промпта').first().json.fallback;\n}\nreturn msgs.filter(Boolean).map(m => ({ json: { text: String(m).slice(0, 4000) } }));"
