    {
      "parameters": {
        "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
        "options": {}
      },
      "name": "CISA KEV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        608
      ],
      "id": "cde747bd-7a13-430c-a96f-d96c5c0a46f4",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const vulns = $input.first().json.vulnerabilities || [];\nconst cutoff = new Date(Date.now() - 3 * 24 * 3600 * 1000);\nreturn vulns\n  .filter(v => new Date(v.dateAdded) >= cutoff)\n  .map(v => ({ json: { type: 'kev', source: 'CISA KEV',\n    title: `${v.cveID} — ${v.vendorProject} ${v.product}`,\n    link: `https://nvd.nist.gov/vuln/detail/${v.cveID}`,\n    summary: v.shortDescription, date: v.dateAdded,\n    extra: `Ransomware: ${v.knownRansomwareCampaignUse} | Дедлайн CISA: ${v.dueDate}` } }));"
      },
      "name": "KEV: новые за 3 дня",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        608
      ],
      "alwaysOutputData": true,
      "id": "d2ce3496-9718-4ba7-b774-115888d589d0"
    },
    {
      "parameters": {
        "jsCode": "const cutoff = Date.now() - 24 * 3600 * 1000;\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst icons = { news: '📰', cve: '🔥', kev: '🚨' };\nconst out = [];\nfor (const item of $input.all()) {\n  let j = item.json;\n  if (!j.title || j.error) continue; // пустые/ошибочные элементы\n  if (!j.type) {\n    const d = j.isoDate || j.pubDate;\n    if (d && new Date(d).getTime() < cutoff) continue;\n    const hm = String(j.link || '').match(/^https?:\\/\\/(?:www\\.)?([^\\/?#]+)/i);\n    const host = hm ? hm[1] : '';\n    j = { type: 'news', source: host, title: j.title, link: j.link,\n          summary: (j.contentSnippet || '').replace(/\\s+/g, ' ').slice(0, 400), date: d };\n  }\n  const text = `${icons[j.type]} <b>${esc(j.title)}</b>\\n<i>${esc(j.source)}</i>\\n\\n${esc(j.summary)}${j.extra ? '\\n' + esc(j.extra) : ''}\\n\\n<a href=\"${esc(j.link)}\">Читать</a>`;\n  out.push({ json: { ...j, text } });\n}\nreturn out;"
      },
      "name": "Нормализация + текст",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
