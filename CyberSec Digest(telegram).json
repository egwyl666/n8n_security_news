      "name": "NVD — новые CVE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        464
      ],
      "id": "79308a5b-9acb-4025-bf36-7d02c649f832",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const vulns = $input.first().json.vulnerabilities || [];\nconst out = [];\nfor (const v of vulns) {\n  const c = v.cve;\n  const m = c.metrics || {};\n  const all = [...(m.cvssMetricV40 || []), ...(m.cvssMetricV31 || []), ...(m.cvssMetricV30 || [])];\n  const score = all.length ? Math.max(...all.map(x => x.cvssData.baseScore)) : null;\n  if (score === null || score < 7) continue;\n  const desc = ((c.descriptions || []).find(d => d.lang === 'en') || {}).value || '';\n  out.push({ json: { type: 'cve', source: 'NVD', title: `${c.id} (CVSS ${score})`,\n    link: `https://nvd.nist.gov/vuln/detail/${c.id}`, summary: desc.slice(0, 400), date: c.published } });\n}\nreturn out;"
      },
      "name": "CVE: фильтр CVSS ≥ 7",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        464
      ],
      "alwaysOutputData": true,
      "id": "68326ba7-f9d2-49d5-b782-5610b4cebf62"
